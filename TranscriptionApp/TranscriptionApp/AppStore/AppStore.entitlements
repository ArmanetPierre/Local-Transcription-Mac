<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Obligatoire pour le Mac App Store -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Importer des enregistrements, exporter des transcriptions -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Memoriser les dossiers autorises pour Claude Code (MCP) -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Telechargement des modeles (Hugging Face), Ollama local -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- API locale (127.0.0.1) pour le serveur MCP de Claude Code -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Enregistrement de reunion : micro -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
